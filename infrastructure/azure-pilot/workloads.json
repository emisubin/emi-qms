            {
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', last(split(parameters('databaseBootstrapIdentityId'), '/')))]",
              "keyVaultUrl": "[format('{0}database-migration-connection-string', format('{0}secrets/', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri))]",
              "name": "database-migration-connection-string"
            },
            {
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', last(split(parameters('databaseBootstrapIdentityId'), '/')))]",
              "keyVaultUrl": "[format('{0}database-runtime-connection-string', format('{0}secrets/', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri))]",
              "name": "database-runtime-connection-string"
            }
          ],
          "triggerType": "Manual"
        },
        "template": {
          "containers": [
            {
              "args": [
                "--bootstrap-database-roles"
              ],
              "env": "[variables('databaseBootstrapEnvironment')]",
              "image": "[parameters('backendImage')]",
              "name": "database-role-bootstrap",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              }
            }
          ]
        },
        "workloadProfileName": "Consumption"
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "frontend",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', last(split(parameters('frontendIdentityId'), '/'))))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "allowInsecure": false,
            "external": true,
            "targetPort": 8080,
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ],
            "transport": "http"
          },
          "registries": "[variables('frontendRegistryConfiguration')]",
          "secrets": [
            {
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', last(split(parameters('frontendIdentityId'), '/')))]",
              "keyVaultUrl": "[reference(resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'front-door-origin-verify-token'), '2023-07-01').secretUri]",
              "name": "origin-verify-token"
            },
            {
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', last(split(parameters('frontendIdentityId'), '/')))]",
              "keyVaultUrl": "[reference(resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), 'entra-access-gate-client-secret'), '2023-07-01').secretUri]",
              "name": "entra-access-gate-client-secret"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "env": [
                {
                  "name": "PUBLIC_HOST",
                  "value": "[parameters('publicHost')]"
                },
                {
                  "name": "BACKEND_FQDN",
                  "value": "[reference(resourceId('Microsoft.App/containerApps', 'backend'), '2024-03-01').configuration.ingress.fqdn]"
                },
                {
                  "name": "FRONT_DOOR_ID",
                  "value": "[parameters('frontDoorId')]"
                },
                {
                  "name": "ORIGIN_VERIFY_TOKEN",
                  "secretRef": "origin-verify-token"
                },
                {
                  "name": "NGINX_ENVSUBST_FILTER",
                  "value": "^(PUBLIC_HOST|BACKEND_FQDN|FRONT_DOOR_ID|ORIGIN_VERIFY_TOKEN)$"
                }
              ],
              "image": "[parameters('frontendImage')]",
              "name": "frontend",
              "probes": [
                {
                  "failureThreshold": 12,
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8080,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "type": "Startup"
                },
                {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8080,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 20,
                  "timeoutSeconds": 3,
                  "type": "Liveness"
                }
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ],
          "scale": {
            "maxReplicas": 2,
            "minReplicas": "[variables('minimumReplicaCount')]"
          }
        },
        "workloadProfileName": "Consumption"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', 'backend')]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps/authConfigs",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', 'frontend', 'current')]",
      "properties": {
        "globalValidation": {
          "excludedPaths": [
            "/health/live",
            "/teams-launcher.html",
            "/teams-launcher.js",
            "/icons/emi-qms-192.png"
          ],
          "redirectToProvider": "azureactivedirectory",
          "unauthenticatedClientAction": "RedirectToLoginPage"
        },
        "httpSettings": {
          "forwardProxy": {
            "convention": "Standard"
          },
          "requireHttps": true,
          "routes": {
            "apiPrefix": "/.auth"
          }
        },
        "identityProviders": {
          "azureActiveDirectory": {
            "enabled": true,
            "isAutoProvisioned": false,
            "registration": {
              "clientId": "[parameters('entraAccessGateClientId')]",
              "clientSecretSettingName": "entra-access-gate-client-secret",
              "openIdIssuer": "[format('{0}{1}/v2.0', environment().authentication.loginEndpoint, parameters('entraTenantId'))]"
            },
            "validation": {
              "allowedAudiences": [
                "[parameters('entraAccessGateClientId')]"
              ]
            }
          }
        },
        "login": {
          "allowedExternalRedirectUrls": [
            "[variables('publicOrigin')]"
          ],
          "cookieExpiration": {
            "convention": "FixedTime",
            "timeToExpiration": "08:00:00"
          },
          "nonce": {
            "nonceExpirationInterval": "00:05:00",
            "validateNonce": true
          },
          "preserveUrlFragmentsForLogins": true,
          "tokenStore": {
            "enabled": false
          }
        },
        "platform": {
          "enabled": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', 'frontend')]"
      ]
    }
  ],
  "outputs": {
    "backendName": {
      "type": "string",
      "value": "backend"
    },
    "backendFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', 'backend'), '2024-03-01').configuration.ingress.fqdn]"
    },
    "clamAvName": {
      "type": "string",
      "value": "clamav"
    },
    "clamAvFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', 'clamav'), '2024-03-01').configuration.ingress.fqdn]"
    },
    "frontendName": {
      "type": "string",
      "value": "frontend"
    },
    "frontendFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', 'frontend'), '2024-03-01').configuration.ingress.fqdn]"
    },
    "migrationJobName": {
      "type": "string",
      "value": "migration"
    },
    "databaseBootstrapJobName": {
      "type": "string",
      "value": "database-role-bootstrap"
    },
    "workloadsActivated": {
      "type": "bool",
      "value": "[parameters('activateWorkloads')]"
    },
    "externalNotificationsEnabled": {
      "type": "bool",
      "value": "[parameters('enableExternalNotifications')]"
    },
    "frontendPreAuthenticationEnabled": {
      "type": "bool",
      "value": true
    }
  }
}