# Public identifiers and operator attestations only. Never put passwords,
# tokens, private keys, or database connection strings in this file.
PUBLIC_HOST=qms.example.com
PUBLIC_HTTPS_PORT=443
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=11111111-1111-1111-1111-111111111111
ENTRA_SPA_CLIENT_ID=22222222-2222-2222-2222-222222222222
ENTRA_API_AUDIENCE=api://11111111-1111-1111-1111-111111111111
ENTRA_API_SCOPE=api://11111111-1111-1111-1111-111111111111/access_as_user
ENTRA_DOMAIN=example.com
RESTORE_VERIFIED_AT_UTC=2026-07-29T00:00:00Z
SECURITY_ALERT_SINK=replace-with-approved-siem-sink
SECURITY_SYSLOG_ADDRESS=tcp+tls://syslog.example.com:6514
SECURITY_SYSLOG_CA_CERT=/secure/path/syslog-ca.pem

# These are paths to root-readable secret files outside the Repository.
TLS_CERTIFICATE_FILE=/secure/path/tls-certificate.pem
TLS_PRIVATE_KEY_FILE=/secure/path/tls-private-key.pem
DATABASE_CONNECTION_STRING_FILE=/secure/path/database-connection-string
BOOTSTRAP_ADMIN_EMAILS_FILE=/secure/path/bootstrap-admin-emails
