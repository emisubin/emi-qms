{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "__APP_VERSION__",
  "id": "__TEAMS_MANIFEST_ID__",
  "developer": {
    "name": "EMI",
    "websiteUrl": "https://__PUBLIC_HOST__/",
    "privacyUrl": "https://__PUBLIC_HOST__/privacy",
    "termsOfUseUrl": "https://__PUBLIC_HOST__/terms"
  },
  "name": {
    "short": "EMI PMS",
    "full": "EMI PMS"
  },
  "description": {
    "short": "EMI 프로젝트 업무와 알림을 한 곳에서 확인합니다.",
    "full": "프로젝트 생성부터 생산관리, 구매, 제조, 품질, 물류와 정산까지 연결하는 EMI 프로젝트 통합관리시스템(EMI PMS)입니다."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#DC2128",
  "staticTabs": [
    {
      "entityId": "home",
      "name": "EMI PMS",
      "contentUrl": "https://__PUBLIC_HOST__/teams-launcher.html",
      "websiteUrl": "https://__PUBLIC_HOST__/",
      "scopes": [
        "personal"
      ]
    }
  ],
  "permissions": [
    "identity"
  ],
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "TeamsActivity.Send.User",
          "type": "Application"
        }
      ]
    }
  },
  "validDomains": [
    "__PUBLIC_HOST__"
  ],
  "webApplicationInfo": {
    "id": "__TEAMS_ACTIVITY_CLIENT_ID__",
    "resource": "__TEAMS_WEB_APP_RESOURCE__"
  },
  "activities": {
    "activityTypes": [
      {
        "type": "projectCreated",
        "description": "프로젝트가 생성되었습니다.",
        "templateText": "{projectName} 프로젝트가 생성되었습니다."
      },
      {
        "type": "projectDeliveryDateChanged",
        "description": "프로젝트 납기일이 변경되었습니다.",
        "templateText": "{projectName} 프로젝트 납기일이 변경되었습니다."
      },
      {
        "type": "projectStatusChanged",
        "description": "프로젝트 상태가 변경되었습니다.",
        "templateText": "{projectName} 프로젝트 상태가 변경되었습니다."
      },
      {
        "type": "workItemAssigned",
        "description": "새 업무가 배정되었습니다.",
        "templateText": "{taskName} 업무가 배정되었습니다."
      },
      {
        "type": "urgentPending",
        "description": "긴급 Pending 조치가 필요합니다.",
        "templateText": "{pendingType} Pending: {title}"
      },
      {
        "type": "reinspectionRequested",
        "description": "재검사가 요청되었습니다.",
        "templateText": "{stageName} 재검사 요청: {title}"
      },
      {
        "type": "deadlineApproaching",
        "description": "업무 예정일이 임박했습니다.",
        "templateText": "{taskName} 업무의 {dueDate}이 임박했습니다."
      },
      {
        "type": "deadlineOverdue",
        "description": "업무 예정일이 지났습니다.",
        "templateText": "{escalationLevel} 단계: {taskName} 업무의 예정일이 지났습니다."
      },
      {
        "type": "projectCompleted",
        "description": "프로젝트가 완료되었습니다.",
        "templateText": "{projectName} 프로젝트가 완료되었습니다."
      },
      {
        "type": "generalNotification",
        "description": "일반 알림이 도착했습니다.",
        "templateText": "{title}"
      }
    ]
  }
}
