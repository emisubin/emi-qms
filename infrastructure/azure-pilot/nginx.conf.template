limit_req_zone $binary_remote_addr zone=emi_api:10m rate=20r/s;

map $http_x_azure_fdid $front_door_id_valid {
    default 0;
    "${FRONT_DOOR_ID}" 1;
}

map $http_x_pms_origin_verify $origin_token_valid {
    default 0;
    "${ORIGIN_VERIFY_TOKEN}" 1;
}

map "$front_door_id_valid:$origin_token_valid" $trusted_edge {
    default 0;
    "1:1" 1;
}

server {
    listen 8080 default_server;
    server_name _;

    client_max_body_size 34m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://login.microsoftonline.com https://*.microsoftonline.com https://graph.microsoft.com; frame-src https://login.microsoftonline.com https://*.microsoftonline.com; frame-ancestors 'self' https://teams.microsoft.com https://*.teams.microsoft.com; form-action 'self' https://login.microsoftonline.com; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    add_header Cross-Origin-Resource-Policy "same-site" always;

    location = /health/live {
        access_log off;
        default_type application/json;
        return 200 '{"status":"healthy"}';
    }

    location ~ ^/(api|health)(/|$) {
        if ($trusted_edge = 0) {
            return 403;
        }

        limit_req zone=emi_api burst=40 nodelay;
        proxy_pass https://${BACKEND_FQDN};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_FQDN};
        proxy_set_header Host ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $http_x_azure_clientip;
        proxy_set_header X-Request-Id $request_id;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Cross-Origin-Resource-Policy;
    }

    location /assets/ {
        if ($trusted_edge = 0) {
            return 403;
        }

        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
    }

    location / {
        if ($trusted_edge = 0) {
            return 403;
        }

        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
