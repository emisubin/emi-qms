    "postgresDatabaseName": {
      "type": "string",
      "value": "emi_qms"
    },
    "applicationInsightsConnectionString": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/components', variables('names').appInsights), '2020-02-02').ConnectionString]"
    },
    "frontDoorProfileName": {
      "type": "string",
      "value": "[variables('names').frontDoorProfile]"
